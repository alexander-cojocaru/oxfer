{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oxfer",
  "version": "0.4.1",
  "identifier": "dev.oxfer.app",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "oxfer",
        "width": 1200,
        "height": 760,
        "minWidth": 800,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "SFTP/FTP client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4MkM3MjAzQjcyNjg0ODUKUldTRmhDYTNBM0lzeUFGY3Y0QW9NRG5BU2dYWGwydTQ1MjNuSnBUaS9yOUl4eENabkcyRUhTNHAK",
      "endpoints": [
        "https://github.com/alexander-cojocaru/oxfer/releases/latest/download/latest.json"
      ]
    }
  }
}
